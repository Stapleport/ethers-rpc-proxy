{
    "name": "ethers-rpc-proxy",
    "version": "2.0.0",
    "description": "A read-only ethers.js RPC proxy running on Cloudflare Workers: unified RPC access + ABI-decoded contract reads, no broadcasting, no private keys. (部署在 Cloudflare Workers 上的只读以太坊 RPC 中转服务，提供统一 RPC 访问与按 ABI 解码的合约读调用。)",
    "scripts": {
        "dev": "bash scripts/dev-loop.sh",
        "dev:once": "wrangler dev",
        "deploy": "wrangler deploy",
        "sync-abi": "node scripts/sync-abi.mjs",
        "check-abi": "node scripts/sync-abi.mjs --check",
        "trim-rpcs": "node scripts/trim-rpcs.mjs",
        "test": "node --test test/read-only.test.mjs"
    },
    "dependencies": {
        "ethers": "^6.7.1",
        "hono": "^4.0.0"
    },
    "devDependencies": {
        "wrangler": "^4.0.0"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "keywords": [
        "ethers",
        "rpc",
        "proxy",
        "cloudflare-workers",
        "blockchain",
        "read-only"
    ],
    "author": "",
    "license": "MIT"
}
